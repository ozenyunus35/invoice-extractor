{
  "name": "invoice-extractor",
  "version": "1.0.0",
  "private": true,
  "description": "Invoice and receipt reader that runs entirely in the browser: OCR, field extraction, VAT checks and Excel export. No server, no API.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.mjs",
    "eval": "vitest run --config vitest.eval.config.ts",
    "corpus": "python3 scripts/corpus/generate.py && node scripts/corpus/render.mjs && node scripts/corpus/ocr-browser.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "pdfjs-dist": "5.7.284",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
